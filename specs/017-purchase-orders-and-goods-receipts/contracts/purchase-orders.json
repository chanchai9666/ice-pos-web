{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PurchaseOrdersAPI",
  "description": "API Contracts for Purchase Orders in ice-pos-web",
  "endpoints": {
    "listPurchaseOrders": {
      "method": "GET",
      "path": "/api/v1/purchase-orders",
      "queryParams": {
        "branchId": { "type": "string", "format": "uuid" },
        "supplierId": { "type": "string", "format": "uuid" },
        "status": { "type": "string", "enum": ["DRAFT", "ORDERED", "PARTIALLY_RECEIVED", "COMPLETED", "CANCELLED"] },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "search": { "type": "string" },
        "page": { "type": "integer", "default": 1 },
        "limit": { "type": "integer", "default": 20 }
      },
      "response": {
        "status": 200,
        "body": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/definitions/PurchaseOrder" }
          },
          "meta": {
            "page": "integer",
            "limit": "integer",
            "total": "integer",
            "totalPages": "integer"
          }
        }
      }
    },
    "createPurchaseOrder": {
      "method": "POST",
      "path": "/api/v1/purchase-orders",
      "requestBody": {
        "branchId": { "type": "string", "format": "uuid", "required": true },
        "supplierId": { "type": "string", "format": "uuid" },
        "orderDate": { "type": "string" },
        "expectedDeliveryDate": { "type": "string" },
        "note": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["DRAFT", "ORDERED"], "default": "ORDERED" },
        "taxAmount": { "type": "integer", "minimum": 0, "default": 0 },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "productId": { "type": "string", "format": "uuid", "required": true },
            "quantity": { "type": "number", "minimum": 0.0001, "required": true },
            "uomId": { "type": "string", "format": "uuid" },
            "unitCost": { "type": "integer", "minimum": 0 },
            "note": { "type": "string", "maxLength": 255 }
          }
        }
      }
    },
    "confirmPurchaseOrder": {
      "method": "POST",
      "path": "/api/v1/purchase-orders/{id}/confirm",
      "responseStatus": 200
    },
    "cancelPurchaseOrder": {
      "method": "POST",
      "path": "/api/v1/purchase-orders/{id}/cancel",
      "responseStatus": 200
    },
    "forceClosePurchaseOrder": {
      "method": "POST",
      "path": "/api/v1/purchase-orders/{id}/close",
      "responseStatus": 200
    },
    "getPendingItemsPreview": {
      "method": "GET",
      "path": "/api/v1/purchase-orders/{id}/receipt-preview",
      "response": {
        "status": 200,
        "items": [
          {
            "purchaseOrderLineId": "string",
            "productId": "string",
            "productName": "string",
            "sku": "string",
            "barcode": "string",
            "orderedQuantity": "number",
            "receivedQuantity": "number",
            "remainingQuantity": "number",
            "unitCost": "integer",
            "uomId": "string",
            "uomName": "string"
          }
        ]
      }
    }
  }
}
